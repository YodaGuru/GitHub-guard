{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "github-guard",
  "blocks": {
    "entry": "src/main.ts",
    "triggers": [
      "onPostSubmit"
    ]
  },
  "permissions": {
    "reddit": {
      "enable": true
    },
    "redis": true,
    "http": {
      "domains": [
        "api.github.com"
      ]
    }
  }
}